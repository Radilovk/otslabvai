{
  "_comment": "Single source of truth for Worker typecheck; jsconfig.json extends this file.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "worker.js",
    "portfolio-api.js",
    "portfolio-import.js",
    "portfolio-filter.js",
    "portfolio-search.js",
    "portfolio-order-validation.js",
    "portfolio-sync-policy.js",
    "portfolio-goals.js",
    "portfolio-pricing.js",
    "portfolio-text.js",
    "portfolio-advisor-engine.js",
    "portfolio-advisor-compose.js",
    "portfolio-advisor-catalog.js",
    "portfolio-advisor-narration.js",
    "portfolio-advisor-settings.js",
    "portfolio-advisor-prompt.js",
    "ai-settings-resolver.js",
    "protocol-quiz-engine.js",
    "protocol-quiz-prompt.js",
    "protocol-stack-composer.js",
    "protocol-quiz-settings.js",
    "protocol-safety-rules.js",
    "life-category-assign.js"
  ],
  "exclude": ["node_modules", "e2e", "backend", "products", "local", "**/*.test.js"]
}
