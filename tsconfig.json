{
  "_comment": "Single source of truth for Worker typecheck; jsconfig.json extends this file.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "worker.js",
    "portfolio-api.js",
    "portfolio-import.js",
    "portfolio-filter.js",
    "portfolio-search.js",
    "portfolio-order-validation.js",
    "portfolio-sync-policy.js",
    "portfolio-goals.js",
    "ai-settings-resolver.js"
  ],
  "exclude": ["node_modules", "e2e", "backend", "products", "**/*.test.js"]
}
